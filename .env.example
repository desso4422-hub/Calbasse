# Copie ce fichier en .env.local et renseigne tes URL de serveur.
# Sans ces variables, l'app fonctionne en mode démo.

# Adresse du serveur de reconnaissance (dossier server/), ex. https://api.calbasse.app
EXPO_PUBLIC_API_URL=

# Point d'accès qui crée la transaction CinetPay et renvoie { "urlPaiement": "..." }
EXPO_PUBLIC_PAIEMENT_API_URL=
