# Clé de l'API Claude (console Anthropic). Ne jamais la mettre dans l'app.
ANTHROPIC_API_KEY=

# Modèle et effort de raisonnement. Compare les réglages avec `npm run evaluer` avant d'en changer.
CALBASSE_MODELE=claude-opus-5-5
CALBASSE_EFFORT=medium

PORT=8787
SCANS_PAR_HEURE=60
DATA_DIR=./donnees
# 1 = garder les photos des scans (uniquement avec l'accord des utilisateurs)
GARDER_PHOTOS=0
