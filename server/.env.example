# ——— Reconnaissance (Gemini) ———
# Clé de l'API Gemini (https://aistudio.google.com/apikey). Ne jamais la mettre dans l'app.
GEMINI_API_KEY=
# Modèle. Vérifie la liste à jour : https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELE=gemini-3.8-flash
# Niveau de réflexion : minimal, low, medium ou high. Vide = valeur par défaut du modèle.
GEMINI_REFLEXION=

# ——— Paiement (CinetPay) ———
# Les trois sont nécessaires ; sans elles, POST /paiements répond 503.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Adresse publique HTTPS de ce serveur (CinetPay y envoie ses notifications)
URL_PUBLIQUE=https://api.calbasse.app
# CINETPAY_URL_API=https://api-checkout.cinetpay.com/v2

# ——— SMS (récupération de compte par numéro de téléphone) ———
# africastalking (production) ou console (développement : le code est écrit dans les logs)
FOURNISSEUR_SMS=
# Africa's Talking : nom d'utilisateur (« sandbox » pour le bac à sable) et clé API
AT_UTILISATEUR=
AT_CLE_API=
# Nom d'expéditeur validé chez Africa's Talking (facultatif)
AT_EXPEDITEUR=

# ——— Serveur ———
PORT=8787
DATA_DIR=./donnees
# Scans par jour : compte gratuit et Premium (MVP : par ex. 10 en gratuit pour les testeurs)
SCANS_GRATUITS=2
SCANS_PREMIUM=30
# Fuseau des quotas journaliers (le compteur de scans repart à minuit, heure locale)
FUSEAU=Africa/Lagos
# Limites anti-abus par adresse IP et par heure
REQUETES_PAR_HEURE=120
COMPTES_PAR_HEURE=10
# 1 si le serveur est derrière un proxy de confiance (lit l'IP dans X-Forwarded-For)
DERRIERE_PROXY=0
# 1 = garder les photos des scans (uniquement avec l'accord des utilisateurs)
GARDER_PHOTOS=0
