# Clé de l'API Gemini (https://aistudio.google.com/apikey). Ne jamais la mettre dans l'app.
GEMINI_API_KEY=

# Modèle. Vérifie la liste à jour : https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELE=gemini-3.8-flash
# Niveau de réflexion : minimal, low, medium ou high. Vide = valeur par défaut du modèle.
# Moins de réflexion = moins cher et plus rapide. Compare avec `npm run evaluer`.
GEMINI_REFLEXION=

PORT=8787
SCANS_PAR_HEURE=60
DATA_DIR=./donnees
# 1 = garder les photos des scans (uniquement avec l'accord des utilisateurs)
GARDER_PHOTOS=0
